FROM ubuntu:24.04

# Установка зависимостей для графики Qt и работы сети
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    wget \
    xvfb \
    libxcb-cursor0 \
    libxcb-xinerama0 \
    libxcb-icccm4 \
    libxcb-keysyms1 \
    libxcb-shape0 \
    libxcb-render0 \
    libxcb-render-util0 \
    libxcb-xfixes0 \
    libxcb-randr0 \
    libxcb-shm0 \
    libxrender1 \
    libxi6 \
    libopengl0 \
    libgl1 \
    libgl1-mesa-dri \
    libglx-mesa0 \
    libxkbcommon-x11-0 \
    libdbus-1-3 \
    libfontconfig1 \
    fontconfig \
    libkrb5-3 \
    libgssapi-krb5-2 \
    libqt6remoteobjects6 \
    libqt6quickcontrols2-6 \
    libqt6core5compat6 \
    iptables \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*


# Скачивание и тихая (unattended) установка AmneziaVPN
WORKDIR /tmp
RUN wget https://github.com/amnezia-vpn/amnezia-client/releases/download/4.8.21.0/AmneziaVPN_4.8.21.0_linux_x64.tar \
    && mkdir installer \
    && tar -xf AmneziaVPN_4.8.21.0_linux_x64.tar -C installer \
    && chmod +x installer/AmneziaVPN_Linux_Installer.bin \
    && xvfb-run --server-args="-screen 0 1024x768x24" ./installer/AmneziaVPN_Linux_Installer.bin \
       --accept-licenses --confirm-command --default-answer install || true \
    && rm -rf /tmp/*

# Путь по умолчанию к бинарнику после установки инсталлятором
CMD ["/opt/AmneziaVPN/AmneziaVPN"]
